page {
  min-height: 100vh;
  color: #142825;
  background: linear-gradient(180deg, #f2faed 0%, #eef7f3 45%, #e4f0ec 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 20rpx 36rpx;
}

.hero {
  margin-bottom: 22rpx;
  text-align: center;
}

.eyebrow {
  color: #6f938b;
  font-size: 22rpx;
  font-weight: 800;
  text-transform: uppercase;
}

.title {
  margin-top: 8rpx;
  font-size: 52rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 0;
}

.subtitle {
  margin-top: 10rpx;
  color: #667d78;
  font-size: 25rpx;
  line-height: 1.55;
}

.search-wrap,
.search-box,
.input-like,
.card,
.forecast-card {
  box-sizing: border-box;
}

.search-wrap {
  position: relative;
  margin-bottom: 22rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  color: #7d9691;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid #e3efea;
  border-radius: 24rpx;
}

.search-icon {
  flex: 0 0 auto;
  margin-right: 12rpx;
  font-size: 34rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #142825;
  font-size: 25rpx;
  line-height: 72rpx;
}

.search-placeholder {
  color: #8aa09b;
  font-size: 25rpx;
}

.search-clear {
  flex: 0 0 48rpx;
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  margin: 0 0 0 10rpx;
  padding: 0;
  color: #6f8882;
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
  background: #eef6f2;
  border: 0;
  border-radius: 999rpx;
}

.search-clear::after {
  border: 0;
}

.search-dropdown,
.search-empty {
  position: absolute;
  top: 88rpx;
  right: 0;
  left: 0;
  z-index: 20;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dceae5;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 38rpx rgba(42, 68, 61, 0.14);
}

.search-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 86rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #edf4f1;
}

.search-result:last-child {
  border-bottom: 0;
}

.search-result.active {
  background: #f2f8e6;
}

.search-result-main {
  min-width: 0;
}

.search-result-name {
  color: #142825;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.search-result-meta,
.search-result-detail {
  color: #718b86;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.35;
}

.search-result-meta {
  margin-top: 4rpx;
}

.search-result-detail {
  flex: 0 0 auto;
  max-width: 280rpx;
  text-align: right;
}

.search-empty {
  padding: 24rpx;
  color: #718b86;
  font-size: 24rpx;
  font-weight: 800;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  color: #718b86;
  font-size: 22rpx;
  font-weight: 800;
}

.input-like {
  width: 100%;
  min-height: 80rpx;
  padding: 0 24rpx;
  color: #142825;
  font-size: 28rpx;
  line-height: 80rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid #dceae5;
  border-radius: 20rpx;
}

.forecast-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-bottom: 20rpx;
}

.weather-error {
  padding: 20rpx 22rpx;
  color: #7a351f;
  background: #fff3ec;
  border: 1rpx solid #f2c8b5;
  border-radius: 20rpx;
}

.weather-error-title {
  font-size: 25rpx;
  font-weight: 900;
}

.weather-error-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.forecast-card {
  position: relative;
  display: flex;
  min-height: 270rpx;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(31, 90, 76, 0.12);
}

.forecast-card::after {
  position: absolute;
  right: -38rpx;
  bottom: -48rpx;
  width: 190rpx;
  height: 190rpx;
  content: "";
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
}

.lime {
  background: #d9ff6f;
}

.green {
  background: #58bf8c;
}

.teal {
  color: #fff;
  background: #145f66;
}

.date-badge {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 112rpx;
  height: 112rpx;
  margin-right: 28rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.86);
  border-radius: 24rpx;
}

.date-week {
  color: #73908a;
  font-size: 22rpx;
  font-weight: 800;
}

.date-day {
  margin-top: 6rpx;
  color: #14312d;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 900;
}

.teal .date-day {
  color: #fff;
}

.forecast-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.forecast-title {
  margin-bottom: 12rpx;
  font-size: 31rpx;
  font-weight: 900;
}

.forecast-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 16rpx;
}

.metric-label {
  color: rgba(20, 40, 37, 0.62);
  font-size: 21rpx;
  font-weight: 800;
}

.teal .metric-label {
  color: rgba(255, 255, 255, 0.62);
}

.metric-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 900;
  white-space: nowrap;
}

.weather-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 38rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  color: rgba(20, 40, 37, 0.72);
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.42);
  border-radius: 999rpx;
}

.weather-icon {
  font-size: 25rpx;
}

.forecast-extra-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.extra-metric {
  min-width: 0;
  padding: 10rpx 8rpx;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 12rpx;
}

.extra-label {
  color: rgba(20, 40, 37, 0.56);
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
}

.teal .extra-label {
  color: rgba(255, 255, 255, 0.64);
}

.extra-value {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  white-space: nowrap;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid #deebe6;
  border-radius: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.section-title {
  margin-top: 6rpx;
  font-size: 33rpx;
  font-weight: 900;
}

.status-pill,
.small-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  color: #155e64;
  font-size: 22rpx;
  font-weight: 900;
  background: #e8f8f2;
  border-radius: 999rpx;
}

.small-action {
  width: 44rpx;
  padding: 0;
  font-size: 30rpx;
}

.probability-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring {
  display: flex;
  width: 210rpx;
  height: 210rpx;
  margin-bottom: 28rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.ring-inner {
  display: flex;
  width: 154rpx;
  height: 154rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
}

.ring-value {
  font-size: 50rpx;
  font-weight: 900;
}

.ring-text {
  margin-top: 8rpx;
  color: #708983;
  font-size: 21rpx;
  font-weight: 800;
}

.factor-list {
  width: 100%;
}

.factor-row {
  display: grid;
  grid-template-columns: 96rpx 1fr 86rpx;
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
  color: #5f7671;
  font-size: 24rpx;
  font-weight: 800;
}

.bar {
  height: 12rpx;
  overflow: hidden;
  background: #e5eeea;
  border-radius: 999rpx;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #55bf8b, #d8ff75);
  border-radius: 999rpx;
}

.guide-line {
  display: flex;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.guide-icon {
  display: flex;
  flex: 0 0 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  color: #155e64;
  background: #eef8f5;
  border-radius: 16rpx;
}

.guide-text {
  flex: 1;
  color: #667d78;
  font-size: 26rpx;
  line-height: 1.65;
}

.route-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 8rpx;
  background: #edf6f3;
  border-radius: 20rpx;
}

.route-tab {
  flex: 1;
  min-height: 52rpx;
  color: #6f8580;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  border-radius: 16rpx;
}

.route-tab.active {
  color: #155e64;
  background: #fff;
  box-shadow: 0 8rpx 18rpx rgba(21, 94, 100, 0.1);
}

.route-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.route-metric {
  padding: 18rpx;
  background: #f7fbfa;
  border: 1rpx solid #edf3f0;
  border-radius: 20rpx;
}

.route-metric text {
  display: block;
  color: #78908b;
  font-size: 21rpx;
  font-weight: 800;
}

.route-metric strong {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
}

.tip-line {
  position: relative;
  padding-left: 24rpx;
  margin-top: 14rpx;
  color: #667d78;
  font-size: 25rpx;
  line-height: 1.6;
}

.tip-line::before {
  position: absolute;
  top: 18rpx;
  left: 2rpx;
  width: 8rpx;
  height: 8rpx;
  content: "";
  background: #55bf8b;
  border-radius: 50%;
}

.schedule-item {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 18rpx;
  align-items: center;
  margin-top: 18rpx;
}

.schedule-time {
  color: #155e64;
  font-size: 23rpx;
  font-weight: 900;
}

.schedule-card {
  padding: 18rpx 20rpx;
  background: #f7fbfa;
  border: 1rpx solid #edf3f0;
  border-radius: 20rpx;
}

.schedule-title {
  font-size: 27rpx;
  font-weight: 900;
}

.schedule-desc {
  margin-top: 6rpx;
  color: #667d78;
  font-size: 23rpx;
  line-height: 1.5;
}

.scene-panel {
  position: relative;
  min-height: 610rpx;
  overflow: hidden;
  padding: 28rpx;
  color: #fff;
  background: linear-gradient(180deg, #0d4454 0%, #1f968c 58%, #0b4a51 100%);
  border-radius: 28rpx;
}

.scene-panel::before {
  position: absolute;
  top: -90rpx;
  left: 50%;
  width: 560rpx;
  height: 560rpx;
  margin-left: -280rpx;
  content: "";
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.scene-top,
.avatar,
.scene-label,
.scene-title,
.scene-meta,
.weather-strip,
.scene-city,
.scene-weather {
  position: relative;
  z-index: 2;
}

.scene-top {
  display: flex;
  justify-content: space-between;
}

.round-button {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.13);
  border-radius: 18rpx;
}

.avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  margin: 28rpx auto 18rpx;
  align-items: center;
  justify-content: center;
  color: #155e64;
  font-size: 54rpx;
  background: #d8ff75;
  border: 10rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
}

.scene-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
  text-transform: uppercase;
}

.scene-title {
  margin-top: 12rpx;
  font-size: 58rpx;
  font-weight: 900;
  text-align: center;
}

.scene-meta {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
  text-align: center;
}

.weather-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 40rpx;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 24rpx;
}

.weather-box {
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.weather-box.light {
  color: #155e64;
  background: rgba(255, 255, 255, 0.92);
}

.weather-box text {
  display: block;
  margin-bottom: 8rpx;
  font-size: 21rpx;
  font-weight: 800;
  opacity: 0.8;
}

.weather-box strong {
  font-size: 29rpx;
}

.scene-city {
  margin-top: 150rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.scene-weather {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.mountain-layer {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
  border-style: solid;
}

.layer-one {
  right: -30rpx;
  border-width: 0 150rpx 300rpx 150rpx;
  border-color: transparent transparent rgba(176, 228, 213, 0.58) transparent;
}

.layer-two {
  left: 26rpx;
  border-width: 0 130rpx 250rpx 130rpx;
  border-color: transparent transparent rgba(145, 202, 193, 0.44) transparent;
}

.forest-line {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent, rgba(5, 54, 58, 0.84));
}
