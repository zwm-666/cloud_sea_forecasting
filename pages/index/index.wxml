<scroll-view class="page {{visualTheme.pageClass}}" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="hero">
    <view class="eyebrow">China Cloud Sea Forecast</view>
    <view class="title">中国名山云海预测</view>
    <view class="subtitle">{{visualTheme.prompt}}</view>
  </view>

  <view class="glass-card forecast-visual-card">
    <view class="visual-head">
      <view>
        <view class="eyebrow">Cloud Probability</view>
        <view class="visual-title">{{currentMountain.name}}云海预测</view>
        <view class="visual-subtitle">{{currentMountain.province}}{{currentMountain.city}} · {{selectedDate}}</view>
      </view>
      <view class="tier-pill" style="color: {{visualTheme.accentTextColor}}; background: {{visualTheme.accentSoftColor}};">{{visualTheme.tierName}}</view>
    </view>

    <view wx:if="{{weatherError}}" class="weather-error">
      <view class="weather-error-title">天气数据暂不可用</view>
      <view class="weather-error-text">{{weatherError}}</view>
    </view>

    <view class="probability-stage">
      <view class="progress-wrap">
        <t-progress
          t-class="cloud-progress"
          theme="circle"
          percentage="{{currentForecast.probability}}"
          color="{{visualTheme.accentColor}}"
          track-color="rgba(255,255,255,0.38)"
          stroke-width="14"
          label="{{false}}"
        />
        <view class="progress-center">
          <view class="probability-number">{{currentForecast.probability}}%</view>
          <view class="probability-label">云海概率</view>
        </view>
      </view>
      <view class="insight-panel">
        <view class="insight-prompt">{{visualTheme.prompt}}</view>
        <view class="insight-copy">观测窗口 {{currentMountain.window}}，日出 {{currentMountain.sunrise}}</view>
        <view class="data-grid">
          <view class="data-item">
            <text>天气</text>
            <view class="data-value">{{currentForecast.weatherLabel}}</view>
          </view>
          <view class="data-item">
            <text>温差</text>
            <view class="data-value">{{currentForecast.tempText || currentForecast.temp}}°C</view>
          </view>
          <view class="data-item">
            <text>风速</text>
            <view class="data-value">{{currentForecast.wind}}m/s</view>
          </view>
        </view>
      </view>
    </view>

    <view class="form-panel">
      <view class="field">
        <view class="label">目的地</view>
        <picker mode="selector" range="{{mountainNames}}" value="{{mountainIndex}}" bindchange="onMountainChange">
          <view class="input-like">{{mountainNames[mountainIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">出发日期</view>
        <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
          <view class="input-like">{{selectedDate}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="forecast-list">
    <view wx:for="{{forecasts}}" wx:key="offset" class="forecast-card {{item.cardTheme.cardClass}}">
      <view class="date-badge">
        <view class="date-week">{{item.week}}</view>
        <view class="date-day">{{item.day}}</view>
      </view>
      <view class="forecast-main">
        <view class="forecast-title">{{item.title}} · {{item.level}}</view>
        <view class="forecast-grid">
          <view>
            <view class="metric-label">云海概率</view>
            <view class="metric-value">{{item.probability}}%</view>
          </view>
          <view>
            <view class="metric-label">温差</view>
            <view class="metric-value">{{item.tempText || item.temp}}°C</view>
          </view>
          <view>
            <view class="metric-label">风速</view>
            <view class="metric-value">{{item.wind}}m/s</view>
          </view>
        </view>
        <view class="forecast-footer">
          <view class="weather-pill">
            <text class="weather-icon">{{item.weatherIcon}}</text>
            <text>{{item.weatherLabel}}</text>
          </view>
          <view class="recommend-pill">{{item.cardTheme.recommendLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="glass-card probability-card">
    <view class="section-head">
      <view>
        <view class="eyebrow">Probability</view>
        <view class="section-title">云海形成概率</view>
      </view>
      <view class="status-pill">{{currentForecast.level}}</view>
    </view>
    <view class="probability-body">
      <view class="ring" style="{{currentForecast.ringStyle}}">
        <view class="ring-inner">
          <view class="ring-value">{{currentForecast.probability}}%</view>
          <view class="ring-text">日出前后</view>
        </view>
      </view>
      <view class="factor-list">
        <view class="factor-row" wx:for="{{factorRows}}" wx:key="name">
          <text>{{item.name}}</text>
          <view class="bar"><view class="bar-fill" style="width: {{item.width}};"></view></view>
          <text>{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <view>
        <view class="eyebrow">Guide</view>
        <view class="section-title">出行指南</view>
      </view>
    </view>
    <view class="guide-line" wx:for="{{guideRows}}" wx:key="index">
      <view class="guide-icon">{{item.icon}}</view>
      <view class="guide-text">{{item.text}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-head route-head">
      <view>
        <view class="eyebrow">Routes</view>
        <view class="section-title">登山路线攻略</view>
      </view>
    </view>
    <view class="route-tabs">
      <view wx:for="{{routeTabs}}" wx:key="name" data-index="{{item.index}}" bindtap="onRouteTap" class="route-tab {{item.className}}">{{item.name}}</view>
    </view>
    <view class="route-metrics">
      <view class="route-metric"><text>耗时</text><strong>{{currentRoute.time}}</strong></view>
      <view class="route-metric"><text>距离</text><strong>{{currentRoute.distance}}</strong></view>
      <view class="route-metric"><text>难度</text><strong>{{currentRoute.difficulty}}</strong></view>
      <view class="route-metric"><text>最佳点</text><strong>{{currentRoute.best}}</strong></view>
    </view>
    <view class="tip-line" wx:for="{{currentRoute.tips}}" wx:key="index">{{item}}</view>
  </view>

  <view class="card">
    <view class="section-head">
      <view>
        <view class="eyebrow">Schedule</view>
        <view class="section-title">推荐行程节奏</view>
      </view>
      <view class="status-pill">今日</view>
    </view>
    <view class="schedule-item" wx:for="{{scheduleItems}}" wx:key="time">
      <view class="schedule-time">{{item.time}}</view>
      <view class="schedule-card">
        <view class="schedule-title">{{item.title}}</view>
        <view class="schedule-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="scene-panel">
    <view class="scene-top">
      <view class="round-button">‹</view>
      <view class="round-button">···</view>
    </view>
    <view class="avatar">⌒</view>
    <view class="scene-label">Selected Mountain</view>
    <view class="scene-title">{{currentMountain.name}}</view>
    <view class="scene-meta">{{currentMountain.province}}{{currentMountain.name}} · 海拔 {{currentMountain.altitude}}</view>
    <view class="weather-strip">
      <view class="weather-box light">
        <text>日出</text>
        <strong>{{currentMountain.sunrise}}</strong>
      </view>
      <view class="weather-box">
        <text>观测窗口</text>
        <strong>{{currentMountain.window}}</strong>
      </view>
    </view>
    <view class="scene-city">{{currentMountain.city}}</view>
    <view class="scene-weather">{{currentMountain.weather}}</view>
    <view class="mountain-layer layer-one"></view>
    <view class="mountain-layer layer-two"></view>
    <view class="forest-line"></view>
  </view>
</scroll-view>
